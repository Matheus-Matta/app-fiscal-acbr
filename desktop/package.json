{
  "name": "comunicador-fiscal-desktop",
  "version": "1.1.0",
  "description": "Comunicador Fiscal ACBr para o PC da loja (Windows e Linux): emite e faz contingência local, sem depender de internet",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "dev": "concurrently -k -n ui,app \"vite\" \"wait-on tcp:5173 && cross-env ACBR_DEV_URL=http://localhost:5173 node scripts/abrir-electron.js\"",
    "start": "npm run build:ui && node scripts/abrir-electron.js",
    "build:ui": "vite build",
    "build:servidor": "node scripts/gerar-servidor.js",
    "build": "npm run build:ui && electron-builder --x64",
    "build:tudo": "npm run build:servidor && npm run build",
    "test": "node --test \"src/main/**/*.test.js\"",
    "build:win": "npm run build:ui && electron-builder --win portable --x64",
    "build:linux": "npm run build:ui && electron-builder --linux AppImage --x64"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "br.com.comunicadorfiscal.desktop",
    "productName": "Comunicador Fiscal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "src/main/**/*",
      "!src/main/**/*.test.js",
      "src/preload/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/icone.png",
        "to": "icone.png"
      }
    ],
    "win": {
      "icon": "resources/icone.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "../server/windows/saida/AcbrFiscal",
          "to": "servidor"
        }
      ]
    },
    "portable": {
      "artifactName": "ComunicadorFiscal-${version}.exe"
    },
    "linux": {
      "icon": "resources/icone.png",
      "category": "Office",
      "synopsis": "Emissor de NFC-e/NF-e pela ACBrLib",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "extraResources": [
        {
          "from": "../server/linux/saida/AcbrFiscal",
          "to": "servidor"
        }
      ]
    },
    "appImage": {
      "artifactName": "ComunicadorFiscal-${version}-x86_64.AppImage"
    }
  },
  "author": "Comunicador Fiscal"
}
