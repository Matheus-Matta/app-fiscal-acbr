{
  "name": "comunicador-fiscal-desktop",
  "version": "1.1.0",
  "description": "Comunicador Fiscal ACBr para o PC da loja: emite e faz contingência local, sem depender de internet",
  "private": true,
  "main": "src/main/main.js",
  "scripts": {
    "dev": "concurrently -k -n ui,app \"vite\" \"wait-on tcp:5173 && cross-env ACBR_DEV_URL=http://localhost:5173 node scripts/abrir-electron.js\"",
    "start": "npm run build:ui && node scripts/abrir-electron.js",
    "build:ui": "vite build",
    "build:servidor": "powershell -NoProfile -ExecutionPolicy Bypass -File ../server/windows/gerar.ps1 -SoExe",
    "build": "npm run build:ui && electron-builder --win portable --x64",
    "build:tudo": "npm run build:servidor && npm run build",
    "test": "node --test \"src/main/**/*.test.js\""
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.3.0",
    "concurrently": "^10.0.7",
    "cross-env": "^10.1.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "vite": "^8.3.8",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "br.com.starchef.comunicadorfiscal",
    "productName": "Comunicador Fiscal",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "src/main/**/*",
      "!src/main/**/*.test.js",
      "src/preload/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server/windows/saida/AcbrFiscal",
        "to": "servidor"
      },
      {
        "from": "resources/icone.png",
        "to": "icone.png"
      }
    ],
    "win": {
      "icon": "resources/icone.png",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "portable": {
      "artifactName": "ComunicadorFiscal-${version}.exe"
    }
  }
}
