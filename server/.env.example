# Copie para .env. O .exe grava este mesmo arquivo na iniciação (`AcbrFiscal.exe configurar`).

# Toda rota /v1 exige Authorization: Bearer <token>. Sem ele, tudo é recusado.
# É o token INICIAL: trocado pela API (/v1/config/token, ou "Gerar novo token" no
# desktop), vale o novo. Apagar data/acesso.json volta a valer este.
ACBRLIB_TOKEN=

# Cifra de ponta a ponta das chamadas. 32 bytes em base64: openssl rand -base64 32
# O cliente precisa da mesma chave. Não pode ser igual ao token.
ACBR_E2E_KEY=

# Origens de navegador permitidas, separadas por vírgula, sem curinga.
# Vazio: nenhuma origem de navegador entra; cliente nativo (sem Origin) segue pelo token.
ACBR_ALLOWED_ORIGINS=

# Porta publicada pelo Docker. O .exe usa ACBR_PORT, com o mesmo padrão, só em 127.0.0.1.
ACBR_PORTA=8030

# 1 = SEFAZ simulada, nada é emitido de verdade. Nunca em produção.
ACBR_SIMULADOR=0
